# Copy to pi/.env with a key of your own: echo "MWIA_KEY=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')" > .env
MWIA_KEY=
# The owner of pi/data, if not 1000:1000 (id -u / id -g):
# MWIA_UID=1000
# MWIA_GID=1000
# Keep what your devices send about your own market orders (data/orders/):
# MWIA_ORDERS=1
